# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.it-runner/envs/010-local.env
.it-runner/envs/080-secret-local.env

# it-runner runtime state
.it-runner/logs/
.it-runner/states/
.it-runner/cache/

# Release artifacts
bin/

# Generated acceptance evidence (keep source scripts, summaries and input manifests)
/docs/evidence/**/*.png
/docs/evidence/**/*.jpg
/docs/evidence/**/*.jpeg
/docs/evidence/**/*.webp
/docs/evidence/**/*.gif
/docs/evidence/**/*.mp4
/docs/evidence/**/*.webm
/docs/evidence/**/*.zip
/docs/evidence/**/*.tar
/docs/evidence/**/*.tar.gz
/docs/evidence/**/*.tgz
/docs/evidence/**/*.log
/docs/evidence/**/*.txt
/docs/evidence/**/*.tsv
/docs/evidence/**/report.json
/docs/evidence/**/attempt-*.json

# Editor/IDE
# .idea/
# .vscode/

.agentflow

